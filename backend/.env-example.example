# Port the Express server listens on
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/cleanconnect?schema=public"

# Origin allowed by CORS (the Vite dev server)
FRONTEND_URL="http://localhost:5173"

# Secret used to sign/verify JWTs. Use a long, random value in real
# environments — never commit the real secret to source control.
JWT_SECRET="replace-with-a-long-random-secret-value"

# How long an issued JWT remains valid
JWT_EXPIRES_IN=1h

# bcrypt hashing cost factor
BCRYPT_SALT_ROUNDS=12

# --- Module 5: complaint photo storage ---
# Optional. Leave all three blank to use local-disk storage under
# /uploads instead (fine for local dev/testing). Set all three to
# use Cloudinary in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base URL this API is reachable at — only used to build the URL of a
# locally-stored complaint photo when Cloudinary isn't configured.
APP_URL=http://localhost:5000

# Maximum accepted complaint photo size, in megabytes.
MAX_UPLOAD_MB=5
