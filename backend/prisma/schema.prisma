generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Module 3 scope: authentication/RBAC (User) + toilet dataset (Toilet).
// Module 5 scope: citizen complaints (Complaint), linked to both.
// Module 6 scope: QR-based toilet identification (no new field needed —
// QR is generated on the fly client-side from cleanConnectId, see
// ToiletQrCode.tsx) + missing-toilet registration requests
// (ToiletRegistrationRequest).
// Module 7 scope: admin-assigned maintenance work (MaintenanceTask),
// performed by Role.STAFF, that resolves a Complaint.
// Module 8 scope: citizen star ratings/reviews of a toilet (Review) —
// independent of Complaint/MaintenanceTask, see Review's own comment.
// Feature models (Reward, etc.) will be added in later modules once
// each feature is designed.

enum Role {
  CITIZEN
  ADMIN
  STAFF
}

model User {
  id                   String                       @id @default(uuid())
  name                 String
  email                String                       @unique
  passwordHash         String
  role                 Role                         @default(CITIZEN)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  complaints           Complaint[]
  toiletRequests       ToiletRegistrationRequest[]
  // Module 7: tasks this user has been assigned as STAFF. Only ever
  // populated for role = STAFF (assignTask validates this — see
  // maintenanceTask.service.ts), but the relation itself doesn't
  // restrict role, same as every other relation on this model.
  assignedTasks        MaintenanceTask[]
  // Module 8: this user's toilet reviews — in practice only ever
  // created by CITIZEN (enforced in review.routes.ts), same pattern as
  // every other role restriction in this schema (not modeled here).
  reviews              Review[]
}

// Sourced from the PMC public-toilet CSV dataset (986 rows) OR created
// directly by an admin OR created by approving a citizen's
// ToiletRegistrationRequest (Module 6) — externalId is only ever
// present for the first case.
// externalId is the dataset's own "Unique ID of CT/PT" — preserved so
// re-running the import can upsert instead of duplicating rows. It is
// nullable (String?, not String) because a toilet registered through
// Module 6 (admin-direct-creation or an approved citizen request) has
// no PMC source record at all — CleanConnect must never invent one.
// Postgres allows multiple NULLs under a UNIQUE constraint, so this
// stays safe for duplicate-detection among the *real* PMC-sourced rows.
// cleanConnectId is CleanConnect's OWN permanent, human-readable
// identifier (e.g. "CC-PMC-0001"), generated by the app — see
// getNextCleanConnectId() in toilet.service.ts. It is nullable
// (String?, not String) deliberately: the Toilet table already has
// imported rows from Module 3 with no cleanConnectId, so a migration
// that added it as required+unique would fail outright (Postgres
// can't satisfy NOT NULL + UNIQUE on existing rows with one shared
// default value). The safe sequence is (1) add it nullable, (2)
// re-run the import script to backfill every existing row, (3) only
// then consider a follow-up migration to tighten it to required —
// that tightening is NOT done in this module. See the Module 4
// report for the exact command sequence.
// ward is Int? (not String?): the real data is clean integers 1-41,
// confirmed by inspecting the CSV, with 2 rows missing a value.
// latitude/longitude are nullable and are NEVER populated with invented
// or fallback coordinates — see importToilets.ts and toilet.service.ts.
model Toilet {
  id                   String                      @id @default(uuid())
  cleanConnectId       String?                     @unique
  externalId           String?                     @unique
  ward                 Int?
  type                 String?
  location             String
  landmark             String?
  status               String?
  isMonetized          Boolean?
  hasIct               Boolean?
  hasGoogleMapsListing Boolean?
  hasIec               Boolean?
  latitude             Float?
  longitude            Float?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  complaints           Complaint[]
  // Set only if this toilet was created by approving a citizen's
  // registration request (Module 6) — null for CSV-imported and
  // admin-direct-created toilets. See ToiletRegistrationRequest below.
  registrationRequest  ToiletRegistrationRequest?
  // Module 8: citizen ratings/reviews for this toilet. Average rating
  // and review count are deliberately NOT stored as columns here —
  // see review.service.ts's getToiletReviews, which computes both
  // with a live Prisma aggregate so they can never go stale.
  reviews              Review[]

  @@index([ward])
}

// Module 5: fixed set of complaint categories, chosen by the citizen
// at submission — kept as a small enum (not free text or a separate
// lookup table) so admin filtering stays simple.
enum ComplaintCategory {
  CLEANLINESS
  WATER_SHORTAGE
  BROKEN_INFRASTRUCTURE
  OTHER
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

// A citizen-reported issue against one registered toilet.
//
// toiletId/userId reference the actual Prisma primary keys
// (Toilet.id, User.id) — never cleanConnectId — so the relation stays
// unambiguous. cleanConnectId (e.g. "CC-PMC-0147") is only ever
// resolved for *display*, via the related toilet — see
// complaint.service.ts.
//
// complaintCode (e.g. "CMP-0012") is CleanConnect's own human-readable
// complaint reference, generated the same way cleanConnectId is (see
// utils/complaintId.ts + getNextComplaintCode in complaint.service.ts):
// sequential, assigned once at creation, never regenerated.
//
// category is chosen by the citizen at submission (there is no AI or
// automatic classification involved — that was removed after initial
// Module 5 testing).
//
// imageUrl stores a URL only (Cloudinary, or a local /uploads path in
// dev — see imageStorage.service.ts) — the image bytes themselves are
// never stored in PostgreSQL. The photo is evidence for an admin to
// review, nothing more.
model Complaint {
  id              String            @id @default(uuid())
  complaintCode   String            @unique
  toiletId        String
  toilet          Toilet            @relation(fields: [toiletId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  description     String
  category        ComplaintCategory
  imageUrl        String?
  status          ComplaintStatus   @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // Module 7: at most one task per complaint — see MaintenanceTask
  // below. Nullable/optional because most complaints start with none;
  // set once an admin assigns one, and never replaced afterwards (a
  // revision cycle reuses the same task, it never creates a second
  // one — see maintenanceTask.service.ts#assignTask's duplicate check).
  maintenanceTask MaintenanceTask?

  @@index([toiletId])
  @@index([userId])
  @@index([status])
}

// Module 6: a citizen's request to register a toilet that isn't in
// CleanConnect's dataset yet. Citizens never write to the Toilet
// table directly (see toiletRequest.service.ts) — this model is the
// only door in, precisely to keep the master Toilet table free of
// duplicates/spam/bad addresses. Approving a request creates a real
// Toilet row through the exact same toilet.service.ts#createToilet
// path used by Module 3/4's admin CRUD and Module 6's admin
// direct-creation UI — there is only ever one CleanConnect ID
// generator in this codebase (getNextCleanConnectId).
//
// requestCode (e.g. "REQ-0012") follows the same generated,
// human-readable pattern as cleanConnectId/complaintCode — see
// utils/toiletRequestId.ts.
//
// resultingToiletId is set only once, at approval time, and never
// changes afterwards — it's how a request and the toilet it produced
// stay linked for provenance, without adding any extra field to
// Toilet itself.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ToiletRegistrationRequest {
  id                String        @id @default(uuid())
  requestCode       String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  location          String
  landmark          String?
  address           String?
  description       String?
  imageUrl          String?
  status            RequestStatus @default(PENDING)
  adminNotes        String?
  resultingToiletId String?       @unique
  resultingToilet   Toilet?       @relation(fields: [resultingToiletId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// Module 7: the admin-assigned, staff-performed maintenance work that
// resolves a Complaint. Deliberately ONE task per complaint
// (complaintId is @unique below) — a revision cycle reuses this same
// row (status cycles SUBMITTED -> REVISION_REQUIRED -> IN_PROGRESS ->
// SUBMITTED again) rather than creating a second task, per Module 7's
// spec. complaintId/assignedStaffId reference the actual Prisma
// primary keys (Complaint.id, User.id) — same pattern as every other
// relation in this schema, never a human-readable code.
//
// taskCode (e.g. "TASK-0012") follows the same generated,
// human-readable pattern as cleanConnectId/complaintCode/requestCode
// — see utils/taskId.ts + getNextTaskCode in maintenanceTask.service.ts.
//
// proofImageUrl is staff's evidence the work was done — a URL only
// (via imageStorage.service.ts, the exact same Module 5 storage used
// for Complaint.imageUrl and ToiletRegistrationRequest.imageUrl), and
// is a completely separate field/photo from Complaint.imageUrl (the
// citizen's original evidence of the problem). Neither is ever
// overwritten by the other.
//
// completedAt is set when staff submits (status -> SUBMITTED);
// verifiedAt is set only when admin verifies (status -> VERIFIED). A
// REVISION_REQUIRED cycle updates adminComment/status but leaves
// completedAt from the most recent submission in place until the next
// submit overwrites it.
enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUIRED
  VERIFIED
}

model MaintenanceTask {
  id              String     @id @default(uuid())
  taskCode        String     @unique
  complaintId     String     @unique
  complaint       Complaint  @relation(fields: [complaintId], references: [id])
  assignedStaffId String
  assignedStaff   User       @relation(fields: [assignedStaffId], references: [id])
  taskInstruction String
  status          TaskStatus @default(ASSIGNED)
  proofImageUrl   String?
  staffComment    String?
  adminComment    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?
  verifiedAt      DateTime?

  @@index([assignedStaffId])
  @@index([status])
}

// Module 8: a citizen's 1–5 star rating of a registered toilet, with
// an optional written comment. Deliberately separate from Complaint —
// a review is subjective experience feedback, not a maintenance
// report, and never automatically creates or resolves a Complaint
// (see review.service.ts).
//
// userId/toiletId reference the actual Prisma primary keys (User.id,
// Toilet.id) — same pattern as every other relation in this schema,
// never cleanConnectId.
//
// @@unique([userId, toiletId]) is what actually enforces "one review
// per citizen per toilet" — not just an application-level check. A
// citizen who wants to change their rating updates this same row
// (PUT /api/reviews/:id) rather than creating a second one; this
// constraint is also exactly what keeps the average rating
// meaningful (one citizen's opinion can't be counted twice).
//
// No imageUrl here on purpose — Module 8 explicitly keeps reviews
// text-only; photographic evidence remains Complaint.imageUrl /
// MaintenanceTask.proofImageUrl's job, not this model's.
model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  toiletId  String
  toilet    Toilet   @relation(fields: [toiletId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, toiletId])
  @@index([toiletId])
}
